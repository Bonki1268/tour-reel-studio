# Tour Reel Studio 設定範例（架構書 §9.2）
# 複製為 repo 根目錄的 .env 後填入；.env 已列入 .gitignore，不可 commit。
# 環境變數優先於 .env 的值。

# development｜test｜production；production 缺少必要設定時拒絕啟動
APP_ENV=development

# API 金鑰：只存在後端環境變數，前端永遠不接觸
# production 必要
ANTHROPIC_API_KEY=
# production 必要；格式 key-id:key-secret
HIGGSFIELD_API_KEY=
# 只給種子腳本使用
FIRECRAWL_API_KEY=

# 模型名稱：程式中不寫死；以下為 S00 技術驗證選定的模型（production 必要）
HF_IMAGE_MODEL=xai/grok-imagine-image-2.0
HF_VIDEO_MODEL=bytedance/seedance-2.5/image-to-video
# 企劃用的 Claude 模型（S10 起使用）
CLAUDE_MODEL=

# 各模型單價表路徑；未設定時為 repo 根目錄的 config/cost_table.json
# 格式見 config/cost_table.example.json（影片單價需從 Higgsfield 控制台確認後填入）
# COST_TABLE=/absolute/path/to/cost_table.json
# 成本上限預留幾鏡的完整重生（關鍵幀＋影片），整數，預設 1
RETRY_RESERVE_SHOTS=1
# 關閉時只用輪詢（Demo 現場網路不穩時使用）
WEBHOOK_ENABLED=true

# 生成工作逾時（秒，自送出起算）與輪詢間隔（秒）
GENERATION_TIMEOUT_S=600
GENERATION_POLL_INTERVAL_S=5

# Redis（工作佇列與進度事件）；未設定時為 infra/docker-compose.test.yml 的本機測試 Redis
# REDIS_URL=redis://localhost:56379/0
# 預簽名網址有效期（秒），上限 900
PRESIGN_TTL_S=900

# PostgreSQL 連線字串（SQLAlchemy 格式）；未設定時為 infra/docker-compose.test.yml 的本機測試資料庫
# DATABASE_URL=postgresql+psycopg://trs:trs@localhost:55432/trs
