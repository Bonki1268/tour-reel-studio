# Tour Reel Studio 設定範例（架構書 §9.2）
# 複製為 repo 根目錄的 .env 後填入；.env 已列入 .gitignore，不可 commit。
# 環境變數優先於 .env 的值。

# development｜test｜production；production 缺少必要設定時拒絕啟動
APP_ENV=development

# API 金鑰：只存在後端環境變數，前端永遠不接觸
# production 必要
ANTHROPIC_API_KEY=
# production 必要；格式 key-id:key-secret
HIGGSFIELD_API_KEY=
# 只給種子腳本使用
FIRECRAWL_API_KEY=

# 模型名稱：程式中不寫死；以下為 S00 技術驗證選定的模型（production 必要）
HF_IMAGE_MODEL=xai/grok-imagine-image-2.0
HF_VIDEO_MODEL=bytedance/seedance-2.5/image-to-video
# 企劃用的 Claude 模型（S10 起使用；CREATIVE_ENGINE=prompt 時必要）。建議值 claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
# 思考強度：low｜medium｜high｜xhigh｜max
CLAUDE_EFFORT=medium
# Claude 拒絕回應時由伺服器端改用其他模型完成（server-side fallback）
CLAUDE_REFUSAL_FALLBACK=true
# 創作引擎：prompt（呼叫 Claude）｜fake（固定企劃，Demo／e2e 用）
CREATIVE_ENGINE=prompt

# 各模型單價表路徑；未設定時為 repo 根目錄的 config/cost_table.json
# 格式見 config/cost_table.example.json（影片單價需從 Higgsfield 控制台確認後填入）
# COST_TABLE=/absolute/path/to/cost_table.json
# 成本上限預留幾鏡的完整重生（關鍵幀＋影片），整數，預設 1
RETRY_RESERVE_SHOTS=1
# 關閉時只用輪詢（Demo 現場網路不穩時使用）
WEBHOOK_ENABLED=true

# 生成工作逾時（秒，自送出起算）與輪詢間隔（秒）
GENERATION_TIMEOUT_S=600
GENERATION_POLL_INTERVAL_S=5

# 保底成品（Demo 可靠性）：自有儲存中事先放好的成品路徑（例如預熱時跑出的成品，以 MinIO 主控台或 mc cp 放入）
# 生成超過門檻秒數時，GET /videos/{id} 回傳 fallback_url；未設定時不提供
# DEMO_FALLBACK_VIDEO=demo/fallback.mp4
DEMO_FALLBACK_AFTER_S=420

# Redis（工作佇列與進度事件）；未設定時為 infra/docker-compose.test.yml 的本機測試 Redis
# REDIS_URL=redis://localhost:56379/0
# 預簽名網址有效期（秒），上限 900
PRESIGN_TTL_S=900

# S3 相容儲存（本機 MinIO；雲端 R2／S3）；未設定時為 infra/docker-compose.test.yml 的本機測試 MinIO
# S3_ENDPOINT_URL=http://localhost:59000
# 瀏覽器可連到的位址（僅用於預簽名網址；docker 內部與外部位址不同時設定）
# S3_PUBLIC_ENDPOINT_URL=
# S3_BUCKET=trs-test
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# PostgreSQL 連線字串（SQLAlchemy 格式）；未設定時為 infra/docker-compose.test.yml 的本機測試資料庫
# DATABASE_URL=postgresql+psycopg://trs:trs@localhost:55432/trs

# 前端（apps/web/.env.local）：首頁導向的 Demo 專案；值為種子腳本（python -m app.seed.run）印出的專案 ID
# 由專案名稱以 UUIDv5 產生，seed/demo/demo.json 的 name 不變時固定
# NEXT_PUBLIC_DEMO_PROJECT_ID=2c0da967-c566-569a-bb77-1f44478e4214
